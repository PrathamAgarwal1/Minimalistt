<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Release builds have no reset receiver at all. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Only the adb shell holds DUMP, so no app on the phone can send this. -->
        <receiver
            android:name=".debug.DebugResetReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="${applicationId}.DEBUG_RESET" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
